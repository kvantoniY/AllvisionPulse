# Public URL for the alpha stand (without trailing slash)
PUBLIC_APP_URL=http://allvision-pulse.ru

# Because alpha runs over plain HTTP/IP, secure cookies must be disabled.
AUTH_COOKIE_SECURE=false

# Backend
NODE_ENV=production
BACKEND_PORT=4000
CORS_ORIGIN=http://YOUR_SERVER_IP,http://allvision-pulse.ru,http://www.allvision-pulse.ru,https://allvision-pulse.ru,https://www.allvision-pulse.ru
UPLOAD_DIR=uploads
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
SOCKET_RECOVERY_MS=60000
CALL_RECONNECT_GRACE_MS=60000
CALL_MAX_PARTICIPANTS=4

# Frontend
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_DB=allvision_pulse
POSTGRES_USER=allvision
POSTGRES_PASSWORD=replace_with_long_random_db_password
DATABASE_URL=postgresql://allvision:replace_with_long_random_db_password@postgres:5432/allvision_pulse?schema=public

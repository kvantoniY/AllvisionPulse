  options ChatEventOption[]
  votes   ChatEventVote[]
}

model ChatEventOption {
  id       String    @id @default(uuid())
  eventId  String
  startsAt DateTime
  endsAt   DateTime?
  label    String?

  event ChatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model ChatEventVote {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  optionId  String
  createdAt DateTime @default(now())

  event ChatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([optionId])

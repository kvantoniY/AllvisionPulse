// Allvision Pulse - Backend data model
// Call/Games/Polls are scaffolded for future work (tables exist, routes minimal).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  CREATOR
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO_NOTE
  SYSTEM
  CALL
}

enum NotificationType {
  POST_LIKED
  POST_COMMENTED
  COMMENT_LIKED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  MESSAGE
  MENTION
  CHAT_EVENT
}

enum FinanceEntryType {
  EXPENSE
  INCOME
}

enum SupportTicketKind {
  PROBLEM
  IDEA
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

enum SupportQuestionStatus {
  OPEN
  ANSWERED
  CLOSED
  ARCHIVED
}

enum AnalyticsEventType {
  PAGE_VIEW
  PAGE_LEAVE
  HEARTBEAT
  ACTION
}


model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)
  avatarUrl          String?
  bio                String?
  suspendedAt        DateTime?
  suspendedUntil     DateTime?
  suspendedPermanent Boolean  @default(false)
  suspensionReason   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastSeenAt         DateTime @default(now())

  settings UserSettings?
  privacy  UserPrivacy?

  sessions Session[]
  posts    Post[]
  comments Comment[]

  postLikes    PostLike[]
  commentLikes CommentLike[]

  sentFriend   Friendship[] @relation("FriendshipSender")
  recvFriend   Friendship[] @relation("FriendshipReceiver")
  blacklistOut Blacklist[]  @relation("BlacklistBlocker")
  blacklistIn  Blacklist[]  @relation("BlacklistBlocked")

  chats            ChatMember[]
  messages         Message[]
  reads            MessageRead[]
  messageReactions MessageReaction[]

  notifications Notification[]

  supportTickets         SupportTicket[]
  supportTicketReplies   SupportTicketReply[]
  supportQuestions       SupportQuestion[]     @relation("SupportQuestionAuthor")
  supportQuestionAnswers SupportQuestion[]     @relation("SupportQuestionAnswerAuthor")
  supportQuestionLikes   SupportQuestionLike[]
  analyticsSessions      AnalyticsSession[]
  analyticsEvents        AnalyticsEvent[]

  healthDays HealthDay[]
  tasks      Task[]
  pulseProfile           PulseProfile?
  pulseConfig            PulseConfig?
  pulseFoods             PulseFood[]
  pulseMeals             PulseMeal[]
  pulseFinanceCategories PulseFinanceCategory[]
  pulseFinanceEntries    PulseFinanceEntry[]
  pulseSavingsGoals      PulseSavingsGoal[]
  pulseDebts             PulseDebt[]
  pulseTaskCompletions   PulseTaskCompletion[]
  pulseGoals             PulseGoal[]

  stories    Story[]
  storyViews StoryView[]
  storyHighlights StoryHighlight[]

  createdChatEvents ChatEvent[]     @relation("ChatEventCreator")
  chatEventVotes    ChatEventVote[]

  @@index([username])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id       String  @id @default(uuid())
  userId   String  @unique
  locale   String? @default("ru")
  timezone String? @default("Europe/Berlin")
  theme    String? @default("system")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPrivacy {
  id                String  @id @default(uuid())
  userId            String  @unique
  showHealthWidgets Boolean @default(true)
  showTasks         Boolean @default(false)
  showEvents        Boolean @default(false)
  profileVisibility String  @default("everyone") // everyone|followers|private
  allowMessagesFrom String  @default("everyone") // everyone|followers|none
  allowCallsFrom    String  @default("everyone") // everyone|followers|none

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Blacklist {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlacklistBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlacklistBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Friendship {
  id         String       @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Post {
  id          String    @id @default(uuid())
  authorId    String
  text        String?
  widgetsJson Json?
  repostOfId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images   PostImage[]
  likes    PostLike[]
  comments Comment[]

  repostOf Post?  @relation("RepostRef", fields: [repostOfId], references: [id])
  reposts  Post[] @relation("RepostRef")

  @@index([authorId, createdAt])
}

model PostImage {
  id     String @id @default(uuid())
  postId String
  url    String
  order  Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Comment {
  id          String    @id @default(uuid())
  postId      String
  authorId    String
  parentId    String?
  text        String?
  widgetsJson Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentTree", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentTree")

  images CommentImage[]
  likes  CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommentImage {
  id        String @id @default(uuid())
  commentId String
  url       String
  order     Int    @default(0)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Chat {
  id        String   @id @default(uuid())
  type      ChatType
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages Message[]    @relation("ChatMessages")

  pinnedMessageId String?  @unique
  pinnedMessage   Message? @relation("ChatPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  messageReads MessageRead[]

  events ChatEvent[]
}

model ChatMember {
  id       String         @id @default(uuid())
  chatId   String
  userId   String
  role     ChatMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())
  leftAt   DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id          String      @id @default(uuid())
  chatId      String
  senderId    String
  type        MessageType @default(TEXT)
  text        String?
  metaJson    Json?
  replyToId   String?
  forwardOfId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  chat   Chat @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // opposite side for Chat.pinnedMessage (one-to-one)
  pinnedByChat Chat? @relation("ChatPinnedMessage")

  replyTo   Message?  @relation("ReplyTo", fields: [replyToId], references: [id])
  replies   Message[] @relation("ReplyTo")
  forwardOf Message?  @relation("ForwardOf", fields: [forwardOfId], references: [id])
  forwards  Message[] @relation("ForwardOf")

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reads       MessageRead[]

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
}

model MessageAttachment {
  id         String @id @default(uuid())
  messageId  String
  url        String
  mime       String
  size       Int
  durationMs Int?
  width      Int?
  height     Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(uuid())
  chatId    String
  messageId String
  userId    String
  readAt    DateTime @default(now())

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId, messageId])
  @@index([chatId, userId, readAt])
}

model Story {
  id            String   @id @default(uuid())
  authorId      String
  mediaUrl      String
  mediaType     String
  durationMs    Int?
  width         Int?
  height        Int?
  itemsJson     Json?
  trimStartMs   Int?
  trimEndMs     Int?
  transformJson Json?
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  author           User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views            StoryView[]
  highlightEntries StoryHighlightItem[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  reaction String?

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId, viewedAt])
}


model StoryHighlight {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries StoryHighlightItem[]

  @@index([userId, updatedAt])
}

model StoryHighlightItem {
  id          String   @id @default(uuid())
  highlightId String
  storyId     String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  highlight StoryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  story     Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([highlightId, storyId])
  @@index([storyId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  data      Json
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model HealthDay {
  id     String   @id @default(uuid())
  userId String
  date   DateTime

  // factors
  sleepHours   Float?
  weightKg     Float?
  sleepQuality Int?
  alcohol       Boolean @default(false)
  coffee        Boolean @default(false)
  wellbeing     Int?
  stress        Int?
  activity      Boolean @default(false)
  productivity  Int?
  nutrition     Int?
  smoking       Boolean @default(false)
  alcoholLevel  Int?
  activityLevel Int?
  caffeineLevel Int?
  comment       String?

  todayScore  Int @default(0)
  pulse7Score Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Task {
  id        String    @id @default(uuid())
  userId    String
  title     String
  notes     String?
  kind      String    @default("TASK") // TASK|EVENT
  dueDate   DateTime?
  hasTime   Boolean   @default(false)
  completed Boolean   @default(false)
  priority  Int       @default(0)

  tags           String[] @default([])
  remindersJson  Json?
  recurrenceJson Json?
  sourceKey      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions PulseTaskCompletion[]

  @@index([userId, dueDate])
  @@index([userId, sourceKey])
}

model PulseProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  heightCm        Float?
  startWeightKg   Float?
  currentWeightKg Float?
  targetWeightKg  Float?
  age             Int?
  dailyCaloriesGoal Int?
  proteinGoal     Float?
  fatGoal         Float?
  carbsGoal       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PulseConfig {
  id                                String   @id @default(uuid())
  userId                            String   @unique
  healthEnabled                     Boolean  @default(true)
  mentalEnabled                     Boolean  @default(true)
  nutritionEnabled                  Boolean  @default(true)
  tasksEnabled                      Boolean  @default(true)
  financeEnabled                    Boolean  @default(true)
  duplicateRecurringExpensesToTasks Boolean  @default(true)
  duplicateDebtPaymentsToTasks      Boolean  @default(true)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PulseFood {
  id           String   @id @default(uuid())
  userId       String?
  name         String
  isDish       Boolean  @default(false)
  defaultGrams Float?
  calories     Int
  protein      Float?
  fat          Float?
  carbs        Float?
  isHealthy    Boolean  @default(false)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([userId, createdAt])
}

model PulseMeal {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime
  title          String
  notes          String?
  totalCalories  Int      @default(0)
  totalProtein   Float?
  totalFat       Float?
  totalCarbs     Float?
  nutritionScore Int      @default(0)
  itemsJson      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model PulseTaskCompletion {
  id        String   @id @default(uuid())
  taskId     String
  userId     String
  date       DateTime
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([userId, date])
}

model PulseFinanceCategory {
  id          String   @id @default(uuid())
  userId      String
  name        String
  limitAmount Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries PulseFinanceEntry[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model PulseFinanceEntry {
  id             String           @id @default(uuid())
  userId         String
  date           DateTime
  type           FinanceEntryType @default(EXPENSE)
  title          String
  amount         Float
  categoryId     String?
  notes          String?
  recurrenceJson Json?
  linkedTaskId   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category PulseFinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model PulseSavingsGoal {
  id           String   @id @default(uuid())
  userId       String
  title        String
  targetAmount Float
  savedAmount  Float    @default(0)
  deadline     DateTime?
  itemsJson    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PulseDebt {
  id            String   @id @default(uuid())
  userId        String
  title         String
  debtType      String
  totalAmount   Float
  paidAmount    Float    @default(0)
  interestRate  Float?
  startedAt     DateTime?
  dueDate       DateTime?
  paymentDay    Int?
  paymentAmount Float?
  termMonths    Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PulseGoal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  progress    Int      @default(0)
  targetDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// --- FUTURE: chat event polls (group chats) ---
model ChatEvent {
  id          String    @id @default(uuid())
  chatId      String
  creatorId   String
  title       String
  description String?
  status      String    @default("DRAFT") // DRAFT|VOTING|FINAL
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime?

  chat    Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  creator User @relation("ChatEventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  options ChatEventOption[]
  votes   ChatEventVote[]
}

model ChatEventOption {
  id       String    @id @default(uuid())
  eventId  String
  startsAt DateTime
  endsAt   DateTime?
  label    String?

  event ChatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model ChatEventVote {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  optionId  String
  createdAt DateTime @default(now())

  event ChatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([optionId])
}

// --- FUTURE: Calls & Games scaffolding ---
model CallRoom {
  id        String    @id @default(uuid())
  roomId    String    @unique
  chatId    String?
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  meta      Json?
}

model GameRoom {
  id             String   @id @default(uuid())
  roomId         String   @unique
  currentGameKey String?
  createdAt      DateTime @default(now())
  meta           Json?
}


model SupportTicket {
  id          String              @id @default(uuid())
  authorId    String
  kind        SupportTicketKind   @default(PROBLEM)
  subject     String
  description String
  category    String?
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  closedAt    DateTime?
  lastReplyAt DateTime?

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies SupportTicketReply[]

  @@index([authorId, status])
  @@index([status, updatedAt])
}

model SupportTicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model SupportQuestion {
  id             String                @id @default(uuid())
  authorId       String
  title          String
  body           String?
  status         SupportQuestionStatus @default(OPEN)
  answerText     String?
  answerAuthorId String?
  answeredAt     DateTime?
  closedAt       DateTime?
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  author       User                  @relation("SupportQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answerAuthor User?                 @relation("SupportQuestionAnswerAuthor", fields: [answerAuthorId], references: [id], onDelete: SetNull)
  likes        SupportQuestionLike[]

  @@index([status, createdAt])
  @@index([archivedAt])
  @@index([authorId, createdAt])
}

model SupportQuestionLike {
  id         String   @id @default(uuid())
  questionId String
  userId     String
  createdAt  DateTime @default(now())

  question SupportQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([userId, createdAt])
}


model AnalyticsSession {
  id               String   @id @default(uuid())
  userId           String
  sessionKey       String
  landingPath      String?
  exitPath         String?
  pageViews        Int      @default(0)
  totalDurationSec Int      @default(0)
  startedAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  endedAt          DateTime?
  isActive         Boolean  @default(true)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events AnalyticsEvent[]

  @@unique([userId, sessionKey])
  @@index([lastSeenAt])
  @@index([startedAt])
  @@index([userId, startedAt])
}

model AnalyticsEvent {
  id           String             @id @default(uuid())
  userId       String
  sessionId    String?
  sessionKey   String
  type         AnalyticsEventType
  path         String
  pageLabel    String?
  referrerPath String?
  actionKey    String?
  durationSec  Int?
  metadata     Json?
  createdAt    DateTime           @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([userId, createdAt])
  @@index([sessionKey, createdAt])
}

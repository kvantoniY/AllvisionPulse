// --- FUTURE: Calls & Games scaffolding ---
model CallRoom {
  id        String    @id @default(uuid())
  roomId    String    @unique
  chatId    String?
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  meta      Json?
}

model GameRoom {
  id             String   @id @default(uuid())
  roomId         String   @unique
  currentGameKey String?
  createdAt      DateTime @default(now())
  meta           Json?
}

model SupportTicket {
  id          String              @id @default(uuid())
  authorId    String
  kind        SupportTicketKind   @default(PROBLEM)
  subject     String
  description String
  category    String?
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  closedAt    DateTime?
  lastReplyAt DateTime?

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies SupportTicketReply[]

  @@index([authorId, status])
  @@index([status, updatedAt])
}

model SupportTicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model SupportQuestion {
  id             String                @id @default(uuid())
  authorId       String
  title          String
  body           String?
  status         SupportQuestionStatus @default(OPEN)
  answerText     String?
  answerAuthorId String?
  answeredAt     DateTime?
  closedAt       DateTime?
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  author       User                  @relation("SupportQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answerAuthor User?                 @relation("SupportQuestionAnswerAuthor", fields: [answerAuthorId], references: [id], onDelete: SetNull)
  likes        SupportQuestionLike[]


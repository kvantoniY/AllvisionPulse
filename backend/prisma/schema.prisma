// Allvision Pulse - Backend data model
// Call/Games/Polls are scaffolded for future work (tables exist, routes minimal).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  CREATOR
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO_NOTE
  SYSTEM
  CALL
}

enum NotificationType {
  POST_LIKED
  POST_COMMENTED
  COMMENT_LIKED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  MESSAGE
  MENTION
  CHAT_EVENT
  ARTIFACT_ACTIVITY
}

enum FinanceEntryType {
  EXPENSE
  INCOME
}

enum SupportTicketKind {
  PROBLEM
  IDEA
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

enum SupportQuestionStatus {
  OPEN
  ANSWERED
  CLOSED
  ARCHIVED
}

enum AnalyticsEventType {
  PAGE_VIEW
  PAGE_LEAVE
  HEARTBEAT
  ACTION
}

enum ProgramAccessMode {
  PRIVATE
  RESTRICTED
  PUBLIC
}

enum ProgramStructureType {
  FIXED_DURATION
  ROLLING
  OPEN_ENDED
}

enum ProgramLifecycleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgramSourceType {
  SYSTEM
  USER
}

enum ProgramActionType {
  TASK
  HEALTH_CHECKIN
  NUTRITION_TARGET
  FINANCE_TARGET
  JOURNAL
  REFLECTION
  REMINDER
  INFO_ONLY
  MILESTONE
  CUSTOM
}

enum ProgramIntegrationType {
  NONE
  TASK_TRACKER
  HEALTH
  NUTRITION
  FINANCE
  JOURNAL
  REMINDER
  PULSE_WIDGET
}

enum ProgramActionStatus {
  PENDING
  COMPLETED
  SKIPPED
  MISSED
  RESCHEDULED
  CANCELLED
}

enum ProgramRunStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  ARCHIVED
  DELETED
}

enum ProgramDayStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  SKIPPED
  MISSED
  RECOVERY
  ARCHIVED
}

enum ProgramEventType {
  RUN_STARTED
  ACTION_COMPLETED
  ACTION_SKIPPED
  ACTION_RESCHEDULED
  DAY_COMPLETED
  DAY_SKIPPED
  RECOVERY_APPLIED
  RUN_PAUSED
  RUN_RESUMED
  RUN_CANCELLED
  RUN_ARCHIVED
  RUN_COMPLETED
  SESSION_JOINED
  SESSION_LEFT
  SESSION_STARTED
  SESSION_COMPLETED
}

enum ProgramRecoveryResolution {
  CONTINUE_CURRENT_DAY
  SOFT_CATCH_UP
  SHIFT_FORWARD
  RECOVERY_DAY
  SKIP_DAY
  COMPLETE_AS_DONE
  COMPLETE_PARTIAL
}

enum ProgramSessionStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProgramSessionJoinMode {
  INVITE_ONLY
  LINK
  OPEN
}

enum ProgramSessionStartMode {
  NOW
  SCHEDULED
  HOST_MANUAL
  AUTO_ON_ACCEPT
}

enum ProgramSessionRole {
  HOST
  MEMBER
}

enum ProgramSessionMemberStatus {
  PENDING
  ACCEPTED
  DECLINED
  LEFT
  REMOVED
}

enum ProgramInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum ProgramShareMode {
  SNAPSHOT
  REFERENCE
  INVITE
}

enum PulseShareArtifactKind {
  WIDGET
  METRIC
  PROGRAM
  PROGRAM_INVITE
  SESSION_INVITE
  PROGRAM_SUMMARY
  PROGRAM_PROGRESS
  ACHIEVEMENT
  TODAY_ACTIONS
  TASK
  FINANCE
  DEBT
  SAVINGS
  ACTION
}

enum PulseActionArtifactType {
  TASK_REQUEST
  TASK_SUGGESTION
  SOCIAL_EVENT
  REMINDER_CARD
  FINANCE_SPLIT
  DEBT_SHARE
  SAVINGS_SHARE
  PROGRAM_INVITE
  PROGRAM_SESSION_INVITE
  PROGRAM_PROGRESS_SHARE
  METRIC_SHARE
}

enum PulseArtifactParticipantRole {
  AUTHOR
  TARGET
  PARTICIPANT
  WATCHER
}

enum PulseArtifactParticipantStatus {
  PENDING
  ACCEPTED
  DECLINED
  ADDED
  COMPLETED
  FOLLOWING
}

enum PulseArtifactActivityType {
  CREATED
  SHARED_TO_CHAT
  ACCEPTED
  DECLINED
  ADDED_TO_PULSE
  COMPLETED
  FOLLOWED
  REMINDER_SET
  SETTLED
  UPDATED
}

enum AchievementDomain {
  PULSE
}

enum AchievementDefinitionKind {
  PROGRAM_COMPLETION
  STAGE_COMPLETION
  MILESTONE
  STREAK
  ADHERENCE
  RECOVERY
  COLLABORATIVE
  TEAM_COMPLETION
  PROGRAM_OUTCOME
}

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  username           String    @unique
  firstName          String?
  lastName           String?
  passwordHash       String
  role               UserRole  @default(USER)
  avatarUrl          String?
  bio                String?
  suspendedAt        DateTime?
  suspendedUntil     DateTime?
  suspendedPermanent Boolean   @default(false)
  suspensionReason   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastSeenAt         DateTime  @default(now())

  settings UserSettings?
  privacy  UserPrivacy?

  sessions Session[]
  posts    Post[]
  comments Comment[]

  postLikes    PostLike[]
  commentLikes CommentLike[]

  sentFriend   Friendship[] @relation("FriendshipSender")
  recvFriend   Friendship[] @relation("FriendshipReceiver")
  blacklistOut Blacklist[]  @relation("BlacklistBlocker")
  blacklistIn  Blacklist[]  @relation("BlacklistBlocked")

  chats            ChatMember[]
  messages         Message[]
  reads            MessageRead[]
  messageReactions MessageReaction[]

  notifications Notification[]
  webPushSubscriptions WebPushSubscription[]

  supportTickets           SupportTicket[]
  supportTicketReplies     SupportTicketReply[]
  supportQuestions         SupportQuestion[]         @relation("SupportQuestionAuthor")
  supportQuestionAnswers   SupportQuestion[]         @relation("SupportQuestionAnswerAuthor")
  supportQuestionLikes     SupportQuestionLike[]
  analyticsSessions        AnalyticsSession[]
  analyticsEvents          AnalyticsEvent[]
  programDefinitions       ProgramDefinition[]       @relation("ProgramOwner")
  publishedProgramVersions ProgramVersion[]          @relation("ProgramPublisher")
  programAccessGrants      ProgramAccessGrant[]      @relation("ProgramGrantUser")
  grantedProgramAccesses   ProgramAccessGrant[]      @relation("ProgramGrantAuthor")
  programRuns              ProgramRun[]
  programRunEvents         ProgramRunEvent[]
  programRecoveryEvents    ProgramRecoveryEvent[]
  hostedProgramSessions    ProgramSession[]          @relation("ProgramSessionHost")
  programSessionMembers    ProgramSessionMember[]
  sentProgramInvites       ProgramSessionInvite[]    @relation("ProgramInviteSender")
  receivedProgramInvites   ProgramSessionInvite[]    @relation("ProgramInviteRecipient")
  pulseShareArtifacts      PulseShareArtifact[]
  artifactAcceptances      PulseArtifactAcceptance[]
  artifactActivityLog      PulseArtifactActivity[]   @relation("PulseArtifactActivityActor")
  artifactActivityTargets  PulseArtifactActivity[]   @relation("PulseArtifactActivitySubject")
  userAchievements         UserAchievement[]

  healthDays             HealthDay[]
  tasks                  Task[]
  pulseProfile           PulseProfile?
  pulseConfig            PulseConfig?
  pulseFoods             PulseFood[]
  pulseMeals             PulseMeal[]
  pulseFinanceCategories PulseFinanceCategory[]
  pulseFinanceEntries    PulseFinanceEntry[]
  pulseSavingsGoals      PulseSavingsGoal[]
  pulseDebts             PulseDebt[]
  pulseTaskCompletions   PulseTaskCompletion[]
  pulseGoals             PulseGoal[]

  stories         Story[]
  storyViews      StoryView[]
  storyHighlights StoryHighlight[]

  createdChatEvents ChatEvent[]     @relation("ChatEventCreator")
  chatEventVotes    ChatEventVote[]

  @@index([username])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id       String  @id @default(uuid())
  userId   String  @unique
  locale   String? @default("ru")
  timezone String? @default("Europe/Berlin")
  theme    String? @default("system")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPrivacy {
  id                    String  @id @default(uuid())
  userId                String  @unique
  showHealthWidgets     Boolean @default(true)
  showTasks             Boolean @default(false)
  showEvents            Boolean @default(false)
  showPulseAchievements Boolean @default(false)
  profileVisibility     String  @default("everyone") // everyone|followers|private
  allowMessagesFrom     String  @default("everyone") // everyone|followers|none
  allowCallsFrom        String  @default("everyone") // everyone|followers|none

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Blacklist {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlacklistBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlacklistBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Friendship {
  id         String       @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Post {
  id          String    @id @default(uuid())
  authorId    String
  text        String?
  widgetsJson Json?
  repostOfId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images   PostImage[]
  likes    PostLike[]
  comments Comment[]

  repostOf Post?  @relation("RepostRef", fields: [repostOfId], references: [id])
  reposts  Post[] @relation("RepostRef")

  @@index([authorId, createdAt])
}

model PostImage {
  id     String @id @default(uuid())
  postId String
  url    String
  order  Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Comment {
  id          String    @id @default(uuid())
  postId      String
  authorId    String
  parentId    String?
  text        String?
  widgetsJson Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentTree", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentTree")

  images CommentImage[]
  likes  CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommentImage {
  id        String @id @default(uuid())
  commentId String
  url       String
  order     Int    @default(0)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Chat {
  id        String   @id @default(uuid())
  type      ChatType
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages Message[]    @relation("ChatMessages")

  pinnedMessageId String?  @unique
  pinnedMessage   Message? @relation("ChatPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  messageReads         MessageRead[]
  originShareArtifacts PulseShareArtifact[] @relation("PulseShareArtifactOriginChat")

  events ChatEvent[]
}

model ChatMember {
  id       String         @id @default(uuid())
  chatId   String
  userId   String
  role     ChatMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())
  leftAt   DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id          String      @id @default(uuid())
  chatId      String
  senderId    String
  type        MessageType @default(TEXT)
  text        String?
  metaJson    Json?
  replyToId   String?
  forwardOfId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  chat   Chat @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // opposite side for Chat.pinnedMessage (one-to-one)
  pinnedByChat Chat? @relation("ChatPinnedMessage")

  replyTo   Message?  @relation("ReplyTo", fields: [replyToId], references: [id])
  replies   Message[] @relation("ReplyTo")
  forwardOf Message?  @relation("ForwardOf", fields: [forwardOfId], references: [id])
  forwards  Message[] @relation("ForwardOf")

  attachments          MessageAttachment[]
  reactions            MessageReaction[]
  reads                MessageRead[]
  originShareArtifacts PulseShareArtifact[] @relation("PulseShareArtifactOriginMessage")

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
}

model MessageAttachment {
  id         String @id @default(uuid())
  messageId  String
  url        String
  mime       String
  size       Int
  durationMs Int?
  width      Int?
  height     Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(uuid())
  chatId    String
  messageId String
  userId    String
  readAt    DateTime @default(now())

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId, messageId])
  @@index([chatId, userId, readAt])
}

model Story {
  id            String   @id @default(uuid())
  authorId      String
  mediaUrl      String
  mediaType     String
  durationMs    Int?
  width         Int?
  height        Int?
  itemsJson     Json?
  trimStartMs   Int?
  trimEndMs     Int?
  transformJson Json?
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  author           User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views            StoryView[]
  highlightEntries StoryHighlightItem[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  reaction String?

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId, viewedAt])
}

model StoryHighlight {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries StoryHighlightItem[]

  @@index([userId, updatedAt])
}

model StoryHighlightItem {
  id          String   @id @default(uuid())
  highlightId String
  storyId     String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  highlight StoryHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  story     Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([highlightId, storyId])
  @@index([storyId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  data      Json
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WebPushSubscription {
  id             String   @id @default(uuid())
  userId         String
  endpoint       String   @unique
  expirationTime DateTime?
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastUsedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model HealthDay {
  id     String   @id @default(uuid())
  userId String
  date   DateTime

  // factors
  sleepHours    Float?
  weightKg      Float?
  sleepQuality  Int?
  alcohol       Boolean @default(false)
  coffee        Boolean @default(false)
  wellbeing     Int?
  stress        Int?
  activity      Boolean @default(false)
  productivity  Int?
  nutrition     Int?
  smoking       Boolean @default(false)
  alcoholLevel  Int?
  activityLevel Int?
  caffeineLevel Int?
  comment       String?

  todayScore  Int @default(0)
  pulse7Score Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Task {
  id        String    @id @default(uuid())
  userId    String
  title     String
  notes     String?
  kind      String    @default("TASK") // TASK|EVENT
  dueDate   DateTime?
  hasTime   Boolean   @default(false)
  completed Boolean   @default(false)
  priority  Int       @default(0)

  tags           String[] @default([])
  remindersJson  Json?
  recurrenceJson Json?
  sourceKey      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions         PulseTaskCompletion[]
  programTaskLinks    ProgramTaskLink[]
  artifactAcceptances PulseArtifactAcceptance[]

  @@index([userId, dueDate])
  @@index([userId, sourceKey])
}

model PulseProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  heightCm          Float?
  startWeightKg     Float?
  currentWeightKg   Float?
  targetWeightKg    Float?
  age               Int?
  dailyCaloriesGoal Int?
  proteinGoal       Float?
  fatGoal           Float?
  carbsGoal         Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PulseConfig {
  id                                String   @id @default(uuid())
  userId                            String   @unique
  healthEnabled                     Boolean  @default(true)
  mentalEnabled                     Boolean  @default(true)
  nutritionEnabled                  Boolean  @default(true)
  tasksEnabled                      Boolean  @default(true)
  financeEnabled                    Boolean  @default(true)
  duplicateRecurringExpensesToTasks Boolean  @default(true)
  duplicateDebtPaymentsToTasks      Boolean  @default(true)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PulseFood {
  id           String   @id @default(uuid())
  userId       String?
  name         String
  isDish       Boolean  @default(false)
  defaultGrams Float?
  calories     Int
  protein      Float?
  fat          Float?
  carbs        Float?
  isHealthy    Boolean  @default(false)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([userId, createdAt])
}

model PulseMeal {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime
  title          String
  notes          String?
  totalCalories  Int      @default(0)
  totalProtein   Float?
  totalFat       Float?
  totalCarbs     Float?
  nutritionScore Int      @default(0)
  itemsJson      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model PulseTaskCompletion {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([userId, date])
}

model PulseFinanceCategory {
  id          String   @id @default(uuid())
  userId      String
  name        String
  limitAmount Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries PulseFinanceEntry[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model PulseFinanceEntry {
  id             String           @id @default(uuid())
  userId         String
  date           DateTime
  type           FinanceEntryType @default(EXPENSE)
  title          String
  amount         Float
  categoryId     String?
  notes          String?
  recurrenceJson Json?
  linkedTaskId   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            PulseFinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  artifactAcceptances PulseArtifactAcceptance[]

  @@index([userId, date])
}

model PulseSavingsGoal {
  id           String    @id @default(uuid())
  userId       String
  title        String
  targetAmount Float
  savedAmount  Float     @default(0)
  deadline     DateTime?
  itemsJson    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifactAcceptances PulseArtifactAcceptance[]

  @@index([userId, createdAt])
}

model PulseDebt {
  id            String    @id @default(uuid())
  userId        String
  title         String
  debtType      String
  totalAmount   Float
  paidAmount    Float     @default(0)
  interestRate  Float?
  startedAt     DateTime?
  dueDate       DateTime?
  paymentDay    Int?
  paymentAmount Float?
  termMonths    Int?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifactAcceptances PulseArtifactAcceptance[]

  @@index([userId, createdAt])
}

model PulseGoal {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  progress    Int       @default(0)
  targetDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ProgramDefinition {
  id                   String                 @id @default(uuid())
  ownerId              String?
  sourceType           ProgramSourceType      @default(USER)
  title                String
  description          String?
  category             String?
  theme                String?
  language             String?                @default("ru")
  coverUrl             String?
  durationDays         Int?
  accessMode           ProgramAccessMode      @default(PRIVATE)
  structureType        ProgramStructureType   @default(FIXED_DURATION)
  collaborativeEnabled Boolean                @default(true)
  lifecycleStatus      ProgramLifecycleStatus @default(DRAFT)
  currentVersionId     String?
  publishedAt          DateTime?
  archivedAt           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  owner           User?                      @relation("ProgramOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  currentVersion  ProgramVersion?            @relation("ProgramCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions        ProgramVersion[]           @relation("ProgramDefinitionVersions")
  accessGrants    ProgramAccessGrant[]
  draftStages     ProgramStage[]
  draftDays       ProgramDayTemplate[]
  draftActions    ProgramActionTemplate[]
  draftRules      ProgramRuleSet?
  draftMilestones ProgramMilestoneTemplate[]
  runs            ProgramRun[]
  sessions        ProgramSession[]

  @@index([ownerId, createdAt])
  @@index([accessMode, lifecycleStatus, publishedAt])
}

model ProgramVersion {
  id                   String               @id @default(uuid())
  definitionId         String
  versionNumber        Int
  title                String
  description          String?
  category             String?
  theme                String?
  language             String?              @default("ru")
  coverUrl             String?
  durationDays         Int?
  accessMode           ProgramAccessMode    @default(PRIVATE)
  structureType        ProgramStructureType @default(FIXED_DURATION)
  collaborativeEnabled Boolean              @default(true)
  publishedById        String?
  publishedAt          DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  definition           ProgramDefinition          @relation("ProgramDefinitionVersions", fields: [definitionId], references: [id], onDelete: Cascade)
  publishedBy          User?                      @relation("ProgramPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  activeForDefinitions ProgramDefinition[]        @relation("ProgramCurrentVersion")
  rules                ProgramRuleSet?
  stages               ProgramStage[]
  days                 ProgramDayTemplate[]
  actions              ProgramActionTemplate[]
  milestones           ProgramMilestoneTemplate[]
  runs                 ProgramRun[]
  sessions             ProgramSession[]

  @@unique([definitionId, versionNumber])
  @@index([definitionId, publishedAt])
}

model ProgramAccessGrant {
  id                  String   @id @default(uuid())
  programDefinitionId String
  userId              String
  grantedById         String
  createdAt           DateTime @default(now())

  programDefinition ProgramDefinition @relation(fields: [programDefinitionId], references: [id], onDelete: Cascade)
  user              User              @relation("ProgramGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy         User              @relation("ProgramGrantAuthor", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([programDefinitionId, userId])
  @@index([userId, createdAt])
}

model ProgramRuleSet {
  id                      String   @id @default(uuid())
  programDefinitionId     String?  @unique
  programVersionId        String?  @unique
  allowSkip               Boolean  @default(true)
  allowPause              Boolean  @default(true)
  allowResume             Boolean  @default(true)
  allowCancel             Boolean  @default(true)
  allowRecovery           Boolean  @default(true)
  maxReschedulesPerAction Int      @default(3)
  recoveryConfigJson      Json?
  progressConfigJson      Json?
  integrationConfigJson   Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  programDefinition ProgramDefinition? @relation(fields: [programDefinitionId], references: [id], onDelete: Cascade)
  programVersion    ProgramVersion?    @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
}

model ProgramStage {
  id                  String   @id @default(uuid())
  programDefinitionId String?
  programVersionId    String?
  order               Int
  title               String
  description         String?
  startDay            Int?
  endDay              Int?
  milestoneText       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  programDefinition ProgramDefinition?         @relation(fields: [programDefinitionId], references: [id], onDelete: Cascade)
  programVersion    ProgramVersion?            @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  days              ProgramDayTemplate[]
  actions           ProgramActionTemplate[]
  milestones        ProgramMilestoneTemplate[]
  runDays           ProgramRunDay[]
  runActions        ProgramRunAction[]
  runsAsCurrent     ProgramRun[]               @relation("ProgramRunCurrentStage")

  @@index([programDefinitionId, order])
  @@index([programVersionId, order])
}

model ProgramDayTemplate {
  id                  String   @id @default(uuid())
  programDefinitionId String?
  programVersionId    String?
  programStageId      String?
  dayNumber           Int?
  title               String?
  dayText             String?
  tipOfDay            String?
  motivationOfDay     String?
  reflectionPrompt    String?
  isRecoveryTemplate  Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  programDefinition ProgramDefinition?         @relation(fields: [programDefinitionId], references: [id], onDelete: Cascade)
  programVersion    ProgramVersion?            @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  stage             ProgramStage?              @relation(fields: [programStageId], references: [id], onDelete: SetNull)
  actions           ProgramActionTemplate[]
  milestones        ProgramMilestoneTemplate[]
  runDays           ProgramRunDay[]

  @@index([programDefinitionId, dayNumber])
  @@index([programVersionId, dayNumber])
}

model ProgramActionTemplate {
  id                   String                 @id @default(uuid())
  programDefinitionId  String?
  programVersionId     String?
  programDayTemplateId String?
  programStageId       String?
  order                Int
  actionType           ProgramActionType
  integrationType      ProgramIntegrationType @default(NONE)
  title                String
  description          String?
  required             Boolean                @default(true)
  estimatedMinutes     Int?
  completionPolicy     String?
  reschedulePolicy     String?
  payloadJson          Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  programDefinition ProgramDefinition?  @relation(fields: [programDefinitionId], references: [id], onDelete: Cascade)
  programVersion    ProgramVersion?     @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  dayTemplate       ProgramDayTemplate? @relation(fields: [programDayTemplateId], references: [id], onDelete: SetNull)
  stage             ProgramStage?       @relation(fields: [programStageId], references: [id], onDelete: SetNull)
  runActions        ProgramRunAction[]

  @@index([programDefinitionId, order])
  @@index([programVersionId, order])
  @@index([programDayTemplateId, order])
}

model ProgramMilestoneTemplate {
  id                   String   @id @default(uuid())
  programDefinitionId  String?
  programVersionId     String?
  programStageId       String?
  programDayTemplateId String?
  order                Int      @default(0)
  title                String
  description          String?
  targetDay            Int?
  metricKey            String?
  payloadJson          Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  programDefinition ProgramDefinition?  @relation(fields: [programDefinitionId], references: [id], onDelete: Cascade)
  programVersion    ProgramVersion?     @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  stage             ProgramStage?       @relation(fields: [programStageId], references: [id], onDelete: SetNull)
  dayTemplate       ProgramDayTemplate? @relation(fields: [programDayTemplateId], references: [id], onDelete: SetNull)

  @@index([programDefinitionId, order])
  @@index([programVersionId, order])
}

model ProgramRun {
  id                      String           @id @default(uuid())
  programDefinitionId     String
  programVersionId        String
  userId                  String
  sessionId               String?
  status                  ProgramRunStatus @default(ACTIVE)
  startedAt               DateTime         @default(now())
  startDate               DateTime
  completedAt             DateTime?
  cancelledAt             DateTime?
  pausedAt                DateTime?
  resumedAt               DateTime?
  archivedAt              DateTime?
  deletedAt               DateTime?
  cancelReason            String?
  currentDayNumber        Int              @default(1)
  currentStageId          String?
  completionPercent       Int              @default(0)
  adherenceScore          Int              @default(100)
  consistencyScore        Int              @default(100)
  streakCount             Int              @default(0)
  missedDaysCount         Int              @default(0)
  skippedActionsCount     Int              @default(0)
  rescheduledActionsCount Int              @default(0)
  stageCompletionPercent  Int              @default(0)
  milestonesEarnedCount   Int              @default(0)
  lastActivityAt          DateTime?
  lastRecoveredAt         DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  programDefinition   ProgramDefinition         @relation(fields: [programDefinitionId], references: [id], onDelete: Cascade)
  programVersion      ProgramVersion            @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStage        ProgramStage?             @relation("ProgramRunCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)
  session             ProgramSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  days                ProgramRunDay[]
  actions             ProgramRunAction[]
  events              ProgramRunEvent[]
  recoveryEvents      ProgramRecoveryEvent[]
  taskLinks           ProgramTaskLink[]
  sessionMember       ProgramSessionMember?
  achievements        UserAchievement[]
  artifactAcceptances PulseArtifactAcceptance[]

  @@index([userId, status, updatedAt])
  @@index([programDefinitionId, status])
  @@index([sessionId, status])
}

model ProgramRunDay {
  id                     String           @id @default(uuid())
  programRunId           String
  programStageId         String?
  programDayTemplateId   String?
  sequenceNumber         Int
  programDayNumber       Int?
  scheduledDate          DateTime
  status                 ProgramDayStatus @default(UPCOMING)
  isRecoveryDay          Boolean          @default(false)
  completedRequiredCount Int              @default(0)
  completedOptionalCount Int              @default(0)
  requiredCount          Int              @default(0)
  optionalCount          Int              @default(0)
  completedAt            DateTime?
  skippedAt              DateTime?
  missedAt               DateTime?
  note                   String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  run         ProgramRun             @relation(fields: [programRunId], references: [id], onDelete: Cascade)
  stage       ProgramStage?          @relation(fields: [programStageId], references: [id], onDelete: SetNull)
  dayTemplate ProgramDayTemplate?    @relation(fields: [programDayTemplateId], references: [id], onDelete: SetNull)
  actions     ProgramRunAction[]
  recoveries  ProgramRecoveryEvent[]

  @@unique([programRunId, sequenceNumber])
  @@index([programRunId, scheduledDate])
}

model ProgramRunAction {
  id                      String                 @id @default(uuid())
  programRunId            String
  programRunDayId         String
  programActionTemplateId String?
  programStageId          String?
  order                   Int
  actionType              ProgramActionType
  integrationType         ProgramIntegrationType @default(NONE)
  title                   String
  description             String?
  required                Boolean                @default(true)
  estimatedMinutes        Int?
  completionPolicy        String?
  reschedulePolicy        String?
  payloadJson             Json?
  status                  ProgramActionStatus    @default(PENDING)
  scheduledDate           DateTime
  completedAt             DateTime?
  skippedAt               DateTime?
  rescheduledToDate       DateTime?
  completionNote          String?
  reflectionText          String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  run            ProgramRun             @relation(fields: [programRunId], references: [id], onDelete: Cascade)
  day            ProgramRunDay          @relation(fields: [programRunDayId], references: [id], onDelete: Cascade)
  actionTemplate ProgramActionTemplate? @relation(fields: [programActionTemplateId], references: [id], onDelete: SetNull)
  stage          ProgramStage?          @relation(fields: [programStageId], references: [id], onDelete: SetNull)
  taskLinks      ProgramTaskLink[]

  @@index([programRunId, scheduledDate, status])
  @@index([programRunDayId, order])
}

model ProgramRunEvent {
  id           String           @id @default(uuid())
  programRunId String
  userId       String?
  eventType    ProgramEventType
  message      String?
  payloadJson  Json?
  createdAt    DateTime         @default(now())

  run  ProgramRun @relation(fields: [programRunId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([programRunId, createdAt])
  @@index([userId, createdAt])
}

model ProgramRecoveryEvent {
  id              String                    @id @default(uuid())
  programRunId    String
  programRunDayId String?
  userId          String
  resolution      ProgramRecoveryResolution
  reasonText      String?
  detailsJson     Json?
  createdAt       DateTime                  @default(now())

  run  ProgramRun     @relation(fields: [programRunId], references: [id], onDelete: Cascade)
  day  ProgramRunDay? @relation(fields: [programRunDayId], references: [id], onDelete: SetNull)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([programRunId, createdAt])
  @@index([userId, createdAt])
}

model ProgramTaskLink {
  id                 String   @id @default(uuid())
  programRunId       String
  programRunActionId String
  taskId             String   @unique
  syncState          String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  run    ProgramRun       @relation(fields: [programRunId], references: [id], onDelete: Cascade)
  action ProgramRunAction @relation(fields: [programRunActionId], references: [id], onDelete: Cascade)
  task   Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([programRunActionId, taskId])
  @@index([programRunId, syncState])
}

model ProgramSession {
  id                  String                  @id @default(uuid())
  programDefinitionId String
  programVersionId    String
  hostId              String
  title               String?
  status              ProgramSessionStatus    @default(DRAFT)
  joinMode            ProgramSessionJoinMode  @default(INVITE_ONLY)
  startMode           ProgramSessionStartMode @default(HOST_MANUAL)
  scheduledStartAt    DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  archivedAt          DateTime?
  cancelledAt         DateTime?
  shareStatus         Boolean                 @default(true)
  shareNumbers        Boolean                 @default(false)
  shareMisses         Boolean                 @default(false)
  shareMilestones     Boolean                 @default(true)
  metricsVisibleJson  Json?
  inviteLinkToken     String?                 @unique
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  programDefinition   ProgramDefinition         @relation(fields: [programDefinitionId], references: [id], onDelete: Cascade)
  programVersion      ProgramVersion            @relation(fields: [programVersionId], references: [id], onDelete: Cascade)
  host                User                      @relation("ProgramSessionHost", fields: [hostId], references: [id], onDelete: Cascade)
  members             ProgramSessionMember[]
  invites             ProgramSessionInvite[]
  runs                ProgramRun[]
  achievements        UserAchievement[]
  artifactAcceptances PulseArtifactAcceptance[]

  @@index([hostId, status, updatedAt])
  @@index([programDefinitionId, status])
}

model ProgramSessionMember {
  id               String                     @id @default(uuid())
  programSessionId String
  userId           String
  programRunId     String?                    @unique
  role             ProgramSessionRole         @default(MEMBER)
  status           ProgramSessionMemberStatus @default(PENDING)
  shareStatus      Boolean                    @default(true)
  shareNumbers     Boolean                    @default(false)
  shareMisses      Boolean                    @default(false)
  shareMilestones  Boolean                    @default(true)
  invitedAt        DateTime                   @default(now())
  joinedAt         DateTime?
  respondedAt      DateTime?
  leftAt           DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  session ProgramSession @relation(fields: [programSessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  run     ProgramRun?    @relation(fields: [programRunId], references: [id], onDelete: SetNull)

  @@unique([programSessionId, userId])
  @@index([userId, status, updatedAt])
}

model ProgramSessionInvite {
  id                String              @id @default(uuid())
  programSessionId  String
  senderId          String
  recipientId       String?
  recipientUsername String?
  inviteToken       String              @unique
  status            ProgramInviteStatus @default(PENDING)
  channel           String?
  shareArtifactId   String?
  message           String?
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())
  respondedAt       DateTime?

  session       ProgramSession      @relation(fields: [programSessionId], references: [id], onDelete: Cascade)
  sender        User                @relation("ProgramInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User?               @relation("ProgramInviteRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  shareArtifact PulseShareArtifact? @relation(fields: [shareArtifactId], references: [id], onDelete: SetNull)

  @@index([programSessionId, status, createdAt])
  @@index([recipientId, status, createdAt])
}

model PulseShareArtifact {
  id                    String                   @id @default(uuid())
  ownerId               String
  kind                  PulseShareArtifactKind
  mode                  ProgramShareMode
  actionType            PulseActionArtifactType?
  title                 String?
  description           String?
  sourceType            String
  sourceId              String?
  snapshotJson          Json?
  referenceJson         Json?
  payloadJson           Json?
  inviteToken           String?                  @unique
  visibilityScope       ProgramAccessMode        @default(PRIVATE)
  containsSensitiveData Boolean                  @default(false)
  allowPublicReference  Boolean                  @default(false)
  originChatId          String?
  originMessageId       String?
  expiresAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  owner            User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originChat       Chat?                     @relation("PulseShareArtifactOriginChat", fields: [originChatId], references: [id], onDelete: SetNull)
  originMessage    Message?                  @relation("PulseShareArtifactOriginMessage", fields: [originMessageId], references: [id], onDelete: SetNull)
  sessionInvites   ProgramSessionInvite[]
  acceptances      PulseArtifactAcceptance[]
  activities       PulseArtifactActivity[]
  userAchievements UserAchievement[]

  @@index([ownerId, createdAt])
  @@index([kind, mode, createdAt])
  @@index([originChatId, createdAt])
}

model PulseArtifactAcceptance {
  id               String                         @id @default(uuid())
  artifactId       String
  userId           String
  role             PulseArtifactParticipantRole   @default(PARTICIPANT)
  status           PulseArtifactParticipantStatus @default(PENDING)
  acceptedAt       DateTime?
  declinedAt       DateTime?
  addedAt          DateTime?
  completedAt      DateTime?
  followedAt       DateTime?
  lastViewedAt     DateTime?
  taskId           String?
  financeEntryId   String?
  debtId           String?
  savingsGoalId    String?
  programRunId     String?
  programSessionId String?
  metaJson         Json?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  artifact       PulseShareArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  financeEntry   PulseFinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: SetNull)
  debt           PulseDebt?         @relation(fields: [debtId], references: [id], onDelete: SetNull)
  savingsGoal    PulseSavingsGoal?  @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)
  programRun     ProgramRun?        @relation(fields: [programRunId], references: [id], onDelete: SetNull)
  programSession ProgramSession?    @relation(fields: [programSessionId], references: [id], onDelete: SetNull)

  @@unique([artifactId, userId])
  @@index([userId, status, updatedAt])
  @@index([taskId])
  @@index([financeEntryId])
  @@index([debtId])
  @@index([savingsGoalId])
  @@index([programRunId])
  @@index([programSessionId])
}

model PulseArtifactActivity {
  id            String                    @id @default(uuid())
  artifactId    String
  actorId       String?
  subjectUserId String?
  type          PulseArtifactActivityType
  payloadJson   Json?
  createdAt     DateTime                  @default(now())

  artifact    PulseShareArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  actor       User?              @relation("PulseArtifactActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  subjectUser User?              @relation("PulseArtifactActivitySubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([artifactId, createdAt])
  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
}

model AchievementDefinition {
  id              String                    @id @default(uuid())
  slug            String                    @unique
  domain          AchievementDomain         @default(PULSE)
  kind            AchievementDefinitionKind
  title           String
  description     String?
  iconKey         String?
  badgeTone       String?
  metricThreshold Int?
  payloadJson     Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  awards UserAchievement[]
}

model UserAchievement {
  id                      String   @id @default(uuid())
  userId                  String
  achievementDefinitionId String
  sourceType              String
  sourceId                String?
  programRunId            String?
  programSessionId        String?
  shareArtifactId         String?
  titleSnapshot           String?
  descriptionSnapshot     String?
  uniqueKey               String   @unique
  awardedAt               DateTime @default(now())
  progressValue           Int?
  progressMax             Int?
  resultJson              Json?

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition    AchievementDefinition @relation(fields: [achievementDefinitionId], references: [id], onDelete: Cascade)
  run           ProgramRun?           @relation(fields: [programRunId], references: [id], onDelete: SetNull)
  session       ProgramSession?       @relation(fields: [programSessionId], references: [id], onDelete: SetNull)
  shareArtifact PulseShareArtifact?   @relation(fields: [shareArtifactId], references: [id], onDelete: SetNull)

  @@index([userId, awardedAt])
  @@index([achievementDefinitionId, awardedAt])
}

// --- FUTURE: chat event polls (group chats) ---
model ChatEvent {
  id          String    @id @default(uuid())
  chatId      String
  creatorId   String
  title       String
  description String?
  status      String    @default("DRAFT") // DRAFT|VOTING|FINAL
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime?

  chat    Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

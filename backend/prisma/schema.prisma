// Allvision Pulse - Backend data model
// Call/Games/Polls are scaffolded for future work (tables exist, routes minimal).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum FriendStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  CREATOR
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO_NOTE
  SYSTEM
  CALL
}

enum NotificationType {
  POST_LIKED
  POST_COMMENTED
  COMMENT_LIKED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  MESSAGE
  MENTION
  CHAT_EVENT
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSeenAt   DateTime @default(now())

  settings UserSettings?
  privacy  UserPrivacy?

  sessions Session[]
  posts    Post[]
  comments Comment[]

  postLikes    PostLike[]
  commentLikes CommentLike[]

  sentFriend   Friendship[] @relation("FriendshipSender")
  recvFriend   Friendship[] @relation("FriendshipReceiver")
  blacklistOut Blacklist[]  @relation("BlacklistBlocker")
  blacklistIn  Blacklist[]  @relation("BlacklistBlocked")

  chats            ChatMember[]
  messages         Message[]
  reads            MessageRead[]
  messageReactions MessageReaction[]

  notifications Notification[]

  healthDays HealthDay[]
  tasks      Task[]

  createdChatEvents ChatEvent[]     @relation("ChatEventCreator")
  chatEventVotes    ChatEventVote[]

  @@index([username])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id       String  @id @default(uuid())
  userId   String  @unique
  locale   String? @default("ru")
  timezone String? @default("Europe/Berlin")
  theme    String? @default("system")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPrivacy {
  id                String  @id @default(uuid())
  userId            String  @unique
  showHealthWidgets Boolean @default(true)
  showTasks         Boolean @default(false)
  showEvents        Boolean @default(false)
  allowMessagesFrom String  @default("everyone") // everyone|friends

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Blacklist {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlacklistBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlacklistBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Friendship {
  id         String       @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Post {
  id          String    @id @default(uuid())
  authorId    String
  text        String?
  widgetsJson Json?
  repostOfId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images   PostImage[]
  likes    PostLike[]
  comments Comment[]

  repostOf Post?  @relation("RepostRef", fields: [repostOfId], references: [id])
  reposts  Post[] @relation("RepostRef")

  @@index([authorId, createdAt])
}

model PostImage {
  id     String @id @default(uuid())
  postId String
  url    String
  order  Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Comment {
  id          String    @id @default(uuid())
  postId      String
  authorId    String
  parentId    String?
  text        String?
  widgetsJson Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentTree", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentTree")

  images CommentImage[]
  likes  CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommentImage {
  id        String @id @default(uuid())
  commentId String
  url       String
  order     Int    @default(0)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Chat {
  id        String   @id @default(uuid())
  type      ChatType
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages Message[]    @relation("ChatMessages")

  pinnedMessageId String?  @unique
  pinnedMessage   Message? @relation("ChatPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  messageReads MessageRead[]

  events ChatEvent[]
}

model ChatMember {
  id       String         @id @default(uuid())
  chatId   String
  userId   String
  role     ChatMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())
  leftAt   DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id          String      @id @default(uuid())
  chatId      String
  senderId    String
  type        MessageType @default(TEXT)
  text        String?
  replyToId   String?
  forwardOfId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  chat   Chat @relation("ChatMessages", fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // opposite side for Chat.pinnedMessage (one-to-one)
  pinnedByChat Chat? @relation("ChatPinnedMessage")

  replyTo   Message?  @relation("ReplyTo", fields: [replyToId], references: [id])
  replies   Message[] @relation("ReplyTo")
  forwardOf Message?  @relation("ForwardOf", fields: [forwardOfId], references: [id])
  forwards  Message[] @relation("ForwardOf")

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reads       MessageRead[]

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
}

model MessageAttachment {
  id         String @id @default(uuid())
  messageId  String
  url        String
  mime       String
  size       Int
  durationMs Int?
  width      Int?
  height     Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(uuid())
  chatId    String
  messageId String
  userId    String
  readAt    DateTime @default(now())

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId, messageId])
  @@index([chatId, userId, readAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  data      Json
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model HealthDay {
  id     String   @id @default(uuid())
  userId String
  date   DateTime

  // factors
  sleepHours   Float?
  sleepQuality Int?
  alcohol      Boolean @default(false)
  coffee       Boolean @default(false)
  wellbeing    Int?
  stress       Int?
  activity     Boolean @default(false)
  productivity Int?
  nutrition    Int?
  smoking      Boolean @default(false)
  comment      String?

  todayScore  Int @default(0)
  pulse7Score Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Task {
  id        String    @id @default(uuid())
  userId    String
  title     String
  notes     String?
  kind      String    @default("TASK") // TASK|EVENT
  dueDate   DateTime?
  hasTime   Boolean   @default(false)
  completed Boolean   @default(false)
  priority  Int       @default(0)

  tags           String[] @default([])
  remindersJson  Json?
  recurrenceJson Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

// --- FUTURE: chat event polls (group chats) ---
model ChatEvent {
  id          String    @id @default(uuid())
  chatId      String
  creatorId   String
  title       String
  description String?
  status      String    @default("DRAFT") // DRAFT|VOTING|FINAL
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime?

  chat    Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  creator User @relation("ChatEventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  options ChatEventOption[]
  votes   ChatEventVote[]
}

model ChatEventOption {
  id       String    @id @default(uuid())
  eventId  String
  startsAt DateTime
  endsAt   DateTime?
  label    String?

  event ChatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model ChatEventVote {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  optionId  String
  createdAt DateTime @default(now())

  event ChatEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([optionId])
}

// --- FUTURE: Calls & Games scaffolding ---
model CallRoom {
  id        String    @id @default(uuid())
  roomId    String    @unique
  chatId    String?
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  meta      Json?
}

model GameRoom {
  id             String   @id @default(uuid())
  roomId         String   @unique
  currentGameKey String?
  createdAt      DateTime @default(now())
  meta           Json?
}

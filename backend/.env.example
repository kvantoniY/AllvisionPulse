NODE_ENV=development
PORT=4000

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allvision_pulse?schema=public

# JWT
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# CORS
# Production example: http://YOUR_SERVER_IP,http://allvision-pulse.ru,http://www.allvision-pulse.ru,https://allvision-pulse.ru,https://www.allvision-pulse.ru
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Uploads
UPLOAD_DIR=uploads

SOCKET_RECOVERY_MS=60000
CALL_RECONNECT_GRACE_MS=60000
CALL_MAX_PARTICIPANTS=4
TURN_HOST=turn.allvision-pulse.ru
TURN_PORT=3478
TURN_TTL_SEC=43200
TURN_SECRET=change_me_turn_secret
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:notify@allvision-pulse.ru

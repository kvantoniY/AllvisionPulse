FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src

# Alpha-only behavior:
# TypeScript currently reports legacy typing errors in several route files,
# but tsc still emits runnable JS into dist/.
# We keep the emitted build for the test stand instead of failing the image build.
RUN npm run build || (test -f dist/server.js && echo "TypeScript errors ignored for alpha deploy; dist emitted")

EXPOSE 4000

CMD ["node", "dist/server.js"]

# Backend base URL (Express)
BACKEND_URL=http://127.0.0.1:4000

# Canonical public app URL used by the client for realtime in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Client-side backend URL fallback. Usually same as app origin behind reverse proxy.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4000

NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_PASSWORD=
